# --- Required for real replies / Discord ---
GROQ_API_KEY=
DISCORD_TOKEN=

# --- API + console security ---
# Required whenever the API is reachable from a non-loopback address.
ADMIN_TOKEN=
CORS_ORIGINS=

# --- Models ---
LILYAI_CHAT_MODEL=openai/gpt-oss-20b
LILYAI_REASONING_MODEL=openai/gpt-oss-120b

# --- Behaviour ---
ALLOWED_USER_IDS=
HISTORY_TURNS=12
TOKEN_BUDGET=6000
WEB_ENABLED=true
# Privacy-preserving default: enable only after obtaining user consent.
LEARN_FROM_CHATS=false

# --- Runtime ---
FRONTEND_DIR=
ENABLE_DISCORD=true
ENABLE_API=true
API_HOST=0.0.0.0
PORT=8000
LILYAI_DATA_DIR=./data
LOG_LEVEL=INFO

# --- Scheduled model scan ---
MODEL_SCAN_ENABLED=true
MODEL_SCAN_INTERVAL_HOURS=24
MODEL_SCAN_MAX_AUTO=6
MODEL_SCAN_DOCS_DIR=

# --- Ops-alert webhook ---
WEBHOOK_URL=

# --- Web search provider ---
TAVILY_API_KEY=

# --- PandaStack sandbox ---
PANDASTACK_API_KEY=
PANDASTACK_TEMPLATE=code-interpreter
PANDASTACK_MAX_RUNS_PER_HOUR=30

# --- Optional VM tool ---
# Disabled by default. Enable only for explicitly approved accounts after reviewing isolation and egress.
LILYAI_VM_TOOL=0
LILYAI_VM_USER_IDS=
LILYAI_VM_MAX_RUNS_PER_HOUR=10

# --- uma.moe circle/fan tracking ---
UMAMOE_API_KEY=
UMAMOE_CIRCLE_IDS=
UMAMOE_NOTIFY_USER_ID=
UMAMOE_POLL_INTERVAL_HOURS=6
UMAMOE_POLL_INTERVAL_SECONDS=

# --- umapyoi.net ---
UMAPYOI_ENABLED=true

# --- Turso (libSQL) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_SYNC_INTERVAL_SECONDS=60

# --- Self-ping ---
SELF_PING_ENABLED=true
SELF_PING_URL=
SELF_PING_INTERVAL_SECONDS=300
